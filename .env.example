TASKA_DEBUG=false
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
TASKA_SECRET_KEY=replace-with-a-long-random-secret
TASKA_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Enable only when the site is served over HTTPS.
TASKA_HTTPS=false
# Comma-separated origins when deploying behind a proxy, e.g. https://taska.example.com
TASKA_CSRF_TRUSTED_ORIGINS=

# Private uploads; Docker overrides this to /data/uploads.
# TASKA_MEDIA_ROOT=/absolute/path/to/private/uploads
TASKA_FILE_LIMIT=52428800
TASKA_SUBMISSION_LIMIT=104857600
# No email service is installed or contacted unless explicitly enabled.
TASKA_EMAIL_ENABLED=false
TASKA_PUBLIC_URL=http://localhost:8000
TASKA_SMTP_HOST=localhost
TASKA_SMTP_PORT=587
TASKA_SMTP_TLS=true
TASKA_SMTP_USER=
TASKA_SMTP_PASSWORD=
TASKA_FROM_EMAIL=taska@localhost
