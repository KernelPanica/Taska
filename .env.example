# Application
TASKA_APP_NAME=Taska
TASKA_DEBUG=true
TASKA_SECRET_KEY=change-me-in-production
TASKA_BASE_URL=http://localhost:8000
# Generate once for deployment, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
TASKA_SETUP_KEY=replace-with-a-long-random-deployment-key

# Passkeys / WebAuthn (HTTPS is required outside localhost)
TASKA_WEBAUTHN_RP_ID=localhost
TASKA_WEBAUTHN_RP_NAME=Taska
TASKA_WEBAUTHN_ORIGIN=http://localhost:8000

# Database
TASKA_DATABASE_URL=sqlite:///./taska.db

# GitHub OAuth (https://github.com/settings/developers)
TASKA_GITHUB_CLIENT_ID=
TASKA_GITHUB_CLIENT_SECRET=

# Telegram Login (создайте бота через @BotFather, /setdomain для домена)
TASKA_TELEGRAM_BOT_TOKEN=
TASKA_TELEGRAM_BOT_USERNAME=
