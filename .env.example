# YourTask — переменные окружения. Для локальной разработки ничего задавать не нужно:
# `npm run dev` и `docker compose up` работают без .env. Этот файл — для production (compose.prod.yaml).

# Профиль: development | test | production (по умолчанию из NODE_ENV)
YOURTASK_PROFILE=production
# Публичный адрес; отсюда строится redirect_uri для YourSpace: <URL>/api/v1/auth/callback
YOURTASK_PUBLIC_URL=https://task.example.com
# Случайная строка ≥ 32 символов: openssl rand -base64 48
YOURTASK_SECRET_KEY=
YOURTASK_DATABASE_PATH=/data/yourtask.db
YOURTASK_LOG_LEVEL=info
YOURTASK_SESSION_TTL_HOURS=168
# За обратным прокси (nginx) — true, чтобы в сессиях был реальный IP
YOURTASK_TRUST_PROXY=true

# Вход аккаунтом YourSpace и каталог людей (docs/adr/0003, 0009). dev — встроенная заглушка (запрещена в production).
# Подключение продукта на сервере YourSpace:
#   npm run cli -- client add yourtask "YourTask" https://task.example.com/api/v1/auth/callback
YOURTASK_YOURSPACE_MODE=oidc
YOURTASK_YOURSPACE_ISSUER=https://id.yourspace.example
YOURTASK_YOURSPACE_CLIENT_ID=yourtask
YOURTASK_YOURSPACE_CLIENT_SECRET=
YOURTASK_YOURSPACE_SCOPES=openid email profile

# Каталог людей YourSpace: как часто опрашивать ленту событий (секунды; 0 — только при запуске и вручную)
YOURTASK_CATALOG_POLL_SECONDS=10
# Токен, с которым YourSpace читает колодцы, команды и норму WIP (GET /api/v1/catalog/org).
# Пусто — выгрузка выключена. Случайная строка ≥ 32 символов: openssl rand -base64 48
YOURTASK_CATALOG_EXPORT_TOKEN=

# Суперадмином YourTask становится суперадмин YourSpace (yourspace_role). Этот список — только для начальной настройки:
# email-адреса через запятую (вход только со второй проверкой)
YOURTASK_SUPERADMIN_EMAILS=

# Префикс ключей тикетов (AOS-1, AOS-2…). Задаётся при установке и потом не меняется.
YOURTASK_KEY_PREFIX=AOS

# Тестовое пространство и пользователи. В production всегда false.
YOURTASK_SEED_TEST_DATA=false

# YourWiki (YT-12, docs/adr/0018): dev — заглушка /dev/yourwiki; api — настоящий YourWiki по контракту WK-02;
# off — блок ссылок без документов. В production по умолчанию api, если задан адрес, иначе off.
# YourWiki узнаёт человека по его токену YourSpace из сессии, отдельного сервисного токена нет.
YOURTASK_YOURWIKI_MODE=
YOURTASK_YOURWIKI_URL=
# Заголовки ссылок с адресов внутренней сети (localhost, 10.x, 192.168.x): только для разработки — защита от SSRF.
YOURTASK_LINK_PREVIEW_PRIVATE=

# Вложения (YT-13, docs/adr/0019): каталог вне публичного каталога веба. По умолчанию — attachments рядом с базой
# (в контейнере /data/attachments). Резервные копии должны включать и его.
YOURTASK_ATTACHMENTS_PATH=
# Как часто системное правило очищает корзину от просроченного, минуты (0 — выключено; срок задаёт суперадмин). docs/adr/0020
YOURTASK_TRASH_SWEEP_MINUTES=60

# Переключатель сайтов YourSpace: откуда брать список сайтов (по умолчанию — YOURTASK_YOURSPACE_ISSUER).
YOURTASK_YOURSPACE_URL=
# Только для разработки (заглушка YourSpace): адреса сайтов, как в .env YourSpace. Пусто — сайт не подключён.
YOURSPACE_YOURDASH_URL=
YOURSPACE_YOURMAIL_URL=
YOURSPACE_YOURTASK_URL=
YOURSPACE_YOURWIKI_URL=
